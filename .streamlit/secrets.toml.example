# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → App → Settings → Secrets.
# NEVER commit the real secrets.toml (it is in .gitignore). The GitHub repo is public.

# Required — Google Sheet of the hospital bite episodes (from the sheet URL .../d/<sheet_id>/edit?gid=<gid>)
[bite_sheet]
sheet_id = "PASTE_SHEET_ID_HERE"
gid = "PASTE_GID_HERE"

# Optional — only if the sheet is PRIVATE (not "anyone with the link").
# Google Cloud service-account key fields; share the sheet (Viewer) with client_email.
# Also add `google-auth` to requirements.txt when using this.
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "xxxxxxxx"
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "psh-rabies-reader@your-project-id.iam.gserviceaccount.com"
# client_id = "000000000000000000000"
# token_uri = "https://oauth2.googleapis.com/token"
