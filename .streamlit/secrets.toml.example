# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → App → Settings → Secrets.
# NEVER commit the real secrets.toml (it is in .gitignore). The GitHub repo is public.

# Required — Google Sheet of the hospital bite episodes (from the sheet URL .../d/<sheet_id>/edit?gid=<gid>)
[bite_sheet]
sheet_id = "PASTE_SHEET_ID_HERE"
gid = "PASTE_GID_HERE"

# 📝 In-app survey form (หน้า "บันทึกสำรวจครัวเรือน") — stores PERSONAL DATA (name, CID, phone).
# The page has no password: it only writes data; the dashboard reads back non-personal columns only.
# RECOMMENDED: Apps Script web app bound to a PRIVATE (Restricted) Google Sheet.
# Setup: see scripts/survey_apps_script.gs. token must equal Script Property TOKEN.
[survey_apps_script]
url = "https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID/exec"
token = "PASTE_LONG_RANDOM_TOKEN"
# ALTERNATIVE: write via service account (needs [gcp_service_account] below + share sheet as EDITOR).
# [survey_sheet]
# sheet_id = "PASTE_PRIVATE_SURVEY_SHEET_ID_HERE"
# Without either, entries go to data/survey_entries.sqlite (lost on Streamlit Cloud restarts).

# Optional — only if the sheet is PRIVATE (not "anyone with the link").
# Google Cloud service-account key fields; share the sheet (Viewer) with client_email.
# Also add `google-auth` to requirements.txt when using this.
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "xxxxxxxx"
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "psh-rabies-reader@your-project-id.iam.gserviceaccount.com"
# client_id = "000000000000000000000"
# token_uri = "https://oauth2.googleapis.com/token"
